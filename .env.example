# Copiar como .env y ajustar si es necesario. Usado por docker-compose.yml.

DB_NAME=banco_db
DB_USERNAME=banco_user
DB_PASSWORD=banco_pass

CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080/api

# Puertos que se publican en la máquina anfitriona. Cámbialos si alguno ya
# está ocupado (por ejemplo, si ya tienes un PostgreSQL escuchando en el 5432).
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
